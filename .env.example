# Mẫu cấu hình cho các module 01–03 (Function Calling, MCP Basics, Production).
# Copy thành `.env` ở thư mục gốc repo rồi điền giá trị thật.
# `.env` đã được .gitignore — KHÔNG commit key.

# --- Module 01: Function Calling (bắt buộc để gọi Gemini) ---
# Lấy key tại: https://aistudio.google.com/apikey
# Cả hai tên đều được nhận: GOOGLE_API_KEY hoặc GEMINI_API_KEY.
GOOGLE_API_KEY=your_google_api_key_here

# --- Module 03a: Authentication demo (KHÔNG phải secret thật) ---
# Chỉ dùng cho môi trường local. Đổi giá trị để thử token khác.
# MCP_AUTH_TOKEN=dev-token-abc123
# MCP_SERVICE_TOKEN=demo-client-key-xyz789
# MCP_LIMITED_TOKEN=demo-no-scope-token

# --- Module 03a: cổng HTTP server ---
# Lưu ý: trên Windows, cổng 8000 có thể bị Docker Desktop chiếm.
# PORT=8000
