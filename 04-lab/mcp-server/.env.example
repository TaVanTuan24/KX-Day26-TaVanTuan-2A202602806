# Copy file này thành `.env` (đã được .gitignore) rồi điền giá trị thật.
# KHÔNG commit file `.env`.
#
# Lấy key miễn phí tại: https://www.weatherapi.com/signup.aspx
# (WeatherAPI free tier: 1 triệu request/tháng, dự báo tối đa 3 ngày)

WEATHERAPI_KEY=your_weatherapi_key_here

# Cổng lắng nghe. Mặc định 8085 khi chạy local; Cloud Run sẽ tự set PORT=8080.
PORT=8085

# Interface. Giữ 0.0.0.0 cho Docker/Cloud Run; dùng 127.0.0.1 nếu chỉ chạy local.
HOST=0.0.0.0

# Transport: mặc định streamable-http. Chỉ đặt stdio khi có client spawn server.
# MCP_TRANSPORT=streamable-http

# Timeout (giây) cho mỗi request tới WeatherAPI.
# WEATHERAPI_TIMEOUT=15
