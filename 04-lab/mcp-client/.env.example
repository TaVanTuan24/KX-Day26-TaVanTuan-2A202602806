# Copy file này thành `.env` trong CÙNG thư mục (04-lab/mcp-client/) rồi điền giá trị.
# KHÔNG commit file `.env`.
#
# Agent đọc .env theo thứ tự ưu tiên:
#   1. 04-lab/mcp-client/.env   (file này)
#   2. <repo root>/.env         (dùng chung cho cả repo — cũng được chấp nhận)
# Cả hai tên GOOGLE_API_KEY và GEMINI_API_KEY đều được nhận (tự động đồng bộ alias).

# Lấy key miễn phí tại: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# URL của MCP server mà agent kết nối tới.
# Local:    http://localhost:8085/mcp
# Cloud Run: https://<service-name>-<hash>-<region>.run.app/mcp
MCP_SERVER_URL=http://localhost:8085/mcp

# (Tuỳ chọn)
# GEMINI_MODEL=gemini-2.5-flash
# MCP_TIMEOUT=30
# MCP_SSE_READ_TIMEOUT=300
